{
  "version": 4,
  "configurations": [
    {
      "name": "daisy",
      "compilerPath": "/opt/homebrew/bin/arm-none-eabi-gcc",
      "cStandard": "gnu11",
      "cppStandard": "gnu++14",
      "intelliSenseMode": "gcc-arm",
      "defines": ["CORE_CM7", "STM32H750xx", "STM32H750IB", "ARM_MATH_CM7", "USE_HAL_DRIVER", "BOOT_APP"],
      "includePath": [
        "${workspaceFolder}/src/**",
        "${workspaceFolder}/lib/libDaisy/src/**",
        "${workspaceFolder}/lib/libDaisy/Drivers/CMSIS_5/CMSIS/Core/Include/**",
        "${workspaceFolder}/lib/libDaisy/Drivers/CMSIS-Device/ST/STM32H7xx/Include/**",
        "${workspaceFolder}/lib/libDaisy/Drivers/STM32H7xx_HAL_Driver/Inc/**",
        "${workspaceFolder}/lib/DaisySP/Source/**"
      ]
    }
  ]
}
